# Project directories. Relative values resolve against the checkout root, not cwd.
# Use absolute paths here for external disks. Quote values containing spaces.
# For an installed wheel, export SKP_PROJECT_ROOT before invoking Python/CLI.
# SKP_PROJECT_ROOT must be exported, not set here (it locates this file).
SKP_DATA_DIR=data
SKP_EXPERIMENTS_DIR=experiments
SKP_ARTIFACTS_DIR=artifacts
SKP_CACHE_DIR=.cache
SKP_QUEUE_DIR=.state/queue

# Required for normal training. Missing/local/unreachable tracking is rejected.
# Copy this file to .env and fill in real values for private environments.
# Local tracking is available only with the per-launch --allow_local_mlflow flag.
# This workstation's standard server listens on port 5001. Change as needed.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
